# Template do .env. Copie para .env e ajuste se necessário:
#
#   cp .env.example .env
#
# .env não é versionado (ver .gitignore). Este arquivo é.

# -----------------------------------------------------------------------------
# ATENÇÃO — tudo com prefixo VITE_ vai para o bundle do navegador.
#
# O Vite substitui import.meta.env.VITE_* em tempo de build, então o valor fica
# legível no JavaScript servido a qualquer visitante. Só entra aqui o que pode
# ser público.
#
# NUNCA use VITE_ para: service role key, token da Meta, chave da OpenAI, senha
# de SMTP, PIN. Segredo de servidor vive em dois lugares e em nenhum outro:
#   · secret da edge function  (supabase secrets set NOME=valor)
#   · private.integration_credentials  (cofre no banco, gravado por RPC)
# -----------------------------------------------------------------------------

# Projeto Supabase. Os três valores abaixo são públicos por construção: a chave
# publicável é a credencial anônima do PostgREST, e quem barra acesso é o RLS,
# não o sigilo dela.
VITE_SUPABASE_PROJECT_ID="mcmqgxvtwegtptfseqvw"
VITE_SUPABASE_URL="https://mcmqgxvtwegtptfseqvw.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_FPuTGgHojfIOahL_NZVclw_dNounr9p"

# Para apontar o front no Supabase local (npm run db:start), troque por:
#   VITE_SUPABASE_URL="http://127.0.0.1:54321"
#   VITE_SUPABASE_PUBLISHABLE_KEY="<anon key impressa pelo supabase start>"
