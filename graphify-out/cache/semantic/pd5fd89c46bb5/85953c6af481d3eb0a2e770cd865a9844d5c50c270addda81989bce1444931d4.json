{"nodes": [{"id": "supabase_readme_schema_novo", "label": "Schema Novo (greenfield FACEIMOB backend)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L1-L26", "rationale": "Modeled from zero out of the 14/07 and 23/07 meeting notes plus what the current frontend requires; nothing was imported from the previous database. Migrations are creation-only (no DROP) because the target is a brand-new empty project. 58 tables, 123 policies, 70 functions, 69 test asserts.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_validate_schema_harness", "label": "scripts/validate-schema.sh --all (disposable Postgres harness)", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L28-L38", "rationale": "Validates without deploying anything: applies every migration to a throwaway Postgres and runs the behavior asserts. Requires only Docker and deliberately avoids the Supabase CLI. Fails if a migration does not apply, if any table in public lacks RLS, or if any behavior assert breaks.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_seed_sql", "label": "supabase/seed.sql (mandatory catalog seed)", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L18-L23", "rationale": "Loads the catalog the product cannot run without: pipeline stages, document types, shifts, general queue, scoring rules and permissions.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_config_toml_project_id", "label": "Stale project_id in supabase/config.toml", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L25-L26", "rationale": "config.toml still points at wkgvqzcqtgyugzykxunj, the old project. The project_id must be swapped for the new project ref before running db push, otherwise the push targets the legacy database.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0001_foundation", "label": "Migration 0001_foundation", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L44", "rationale": "Extensions, private schema, 13 enums and helpers slugify, normalize_phone, month_start.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0002_identity", "label": "Migration 0002_identity", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L45", "rationale": "profiles, user_roles (N:N), teams, team_members with history, visibility functions and permissions.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0003_catalog", "label": "Migration 0003_catalog", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L46", "rationale": "Construtoras, empreendimentos, pipeline stages, document types and lead origins.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0004_distribution", "label": "Migration 0004_distribution", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L47", "rationale": "Shifts, allowed IPs, check-ins, distribution groups and automation settings.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0005_leads", "label": "Migration 0005_leads", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L48", "rationale": "Leads with UTM/campaign tracking, roleta distribution, attendance lock, event log and comments.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0006_deals", "label": "Migration 0006_deals", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L49", "rationale": "Deals, clients (titular plus joint buyer), participants with VGV split and versioned documents.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0007_cca", "label": "Migration 0007_cca", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L50", "rationale": "Credit-analysis conveyor and the outbound queue to the external construtora.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0008_sdr", "label": "Migration 0008_sdr", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L51", "rationale": "AI agents, WhatsApp templates, conversations and remarketing.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0009_daily", "label": "Migration 0009_daily", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L52", "rationale": "Per-team daily, funnel targets and public links protected by PIN.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0010_gamification", "label": "Migration 0010_gamification", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L53", "rationale": "Seasons with manual closing, configurable scoring and freezing.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0011_marketing_workspace", "label": "Migration 0011_marketing_workspace", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L54", "rationale": "Marketing investments, campaigns, targets, tasks, notifications and integrations.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_0012_crud_fixes", "label": "Migration 0012_crud_fixes", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L55", "rationale": "Fixes from the CRUD audit plus the missing frontend surfaces cca_stages, annual_results and the storage buckets.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_crud_audit", "label": "CRUD Audit (six findings)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L59-L92", "rationale": "Run after the schema was finished, confronting the real policy matrix against what each screen needs. All six findings were reproduced in a failing test before being fixed, with regressions kept in tests/03_crud_audit.sql. Findings: broker could change own bypass_ip_check and own status; broker could not check out of own shift; manually created deal was born without a participant (invisible and uneditable, and the INSERT failed outright with supabase-js .select()); broker could inject a comment into another team's lead by passing the UUID; deal_clients DELETE was governed by the read rule and was more permissive than INSERT/UPDATE.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_rls_row_not_column", "label": "RLS Filters Rows, Not Columns", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L74-L76", "rationale": "Root cause shared by audit findings 1 and 2. The profiles_update_self policy releases the whole row, so a row-level policy can never protect an individual administrative column; guarding a field requires a trigger instead.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_profiles_guard_admin_columns", "label": "profiles_guard_admin_columns()", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L76", "rationale": "Trigger that blocks a broker from self-editing administrative columns (bypass_ip_check, status) which row-level RLS cannot protect.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_returning_policy_before_after_trigger", "label": "INSERT ... RETURNING Evaluates the SELECT Policy Before AFTER Triggers Fire", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L78-L82", "rationale": "An AFTER INSERT trigger cannot fix visibility of a freshly inserted deal: Postgres evaluates the SELECT policy against the new row before AFTER triggers run, so deal_participants is still empty at that instant. Visibility had to be changed to read created_by off the row itself.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_immutable_log_tables", "label": "Deliberately Write-Free Immutable Log Tables", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L89-L92", "rationale": "Verified end state: no table has DELETE more permissive than INSERT/UPDATE, and five tables have no write policy at all because they are immutable logs - lead_events, lead_assignments, deal_history, cca_case_events, sdr_messages - all written exclusively by SECURITY DEFINER functions.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_roles_n_to_n", "label": "Roles Are N:N (user_roles)", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L96-L98", "rationale": "Explicit requirement: a director may also act as manager and broker. The old schema duplicated the role in two places, which is what caused Rafael to receive a CCA notification without holding the role.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_auth_visible_profiles", "label": "auth_visible_profiles()", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L100-L103", "rationale": "Single source of truth for visibility: broker sees only himself, manager sees the team, director sees the teams he directs, admin/socio see everyone. Leads, deals, metrics and targets all filter through it, so changing the hierarchy rule means editing one place.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_deal_participants", "label": "deal_participants (replaces broker1/2/3 and manager1/2/3)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L105-L108", "rationale": "The hard limit of 3 was arbitrary and made any per-broker aggregation impossible, so the fixed columns became rows.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_vgv_split", "label": "VGV Split Computed in the Database, Always Closing at 100%", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L107-L108", "rationale": "The rateio is calculated in the database rather than the client so it always sums to 100%, including the three-broker case (33.334/33.333/33.333) where naive rounding would lose a thousandth.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_deal_clients", "label": "deal_clients (ordinal 1 or 2)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L110-L111", "rationale": "The 12 duplicated second-buyer fields became rows distinguished by ordinal, removing the parallel column set.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_deal_documents", "label": "deal_documents (typed and versioned)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L113-L115", "rationale": "Replaces the single attachment field. Re-sending a document does not erase the previous one: it is marked as superseded and carries a version, which is the change history the CCA team asked for.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_no_secrets_in_public_schema", "label": "No Password or Token in the Public Schema", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L117-L120", "rationale": "Authentication is 100% Supabase Auth. Secrets live outside anything PostgREST can reach, so a policy mistake cannot leak credentials.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_private_integration_credentials", "label": "private.integration_credentials", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L118-L120", "rationale": "API tokens live in a schema PostgREST does not expose; the admin writes them via RPC and never receives the value back, so the token is write-only from the application's perspective.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_pin_bcrypt_hash", "label": "Public Link PIN Stored as bcrypt Hash", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L120", "rationale": "The PIN protecting public daily links is never stored in clear text, so leaking the row does not grant access to the link.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_anon_surface", "label": "Anonymous Surface Is Exactly Three Functions", "file_type": "rationale", "source_file": "supabase/README.md", "source_location": "L122-L124", "rationale": "No table is readable by anon; the entire unauthenticated attack surface is three RPCs, which bounds what a leaked anon key can do.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_public_daily_team", "label": "public_daily_team()", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_public_daily_submit", "label": "public_daily_submit()", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_public_director_checkpoint", "label": "public_director_checkpoint()", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_closed_months", "label": "closed_months (closed month locks editing)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L126-L128", "rationale": "Prevents a past report from changing retroactively - the direct answer to the complaint about discrepancies in the annual numbers.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_pipeline_stages", "label": "pipeline_stages (configurable pipeline stages)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_cca_stages", "label": "cca_stages (configurable CCA stages)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L84-L87", "rationale": "Created because the frontend already used it and it did not exist; deliberately follows the same pattern as pipeline_stages.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_annual_results", "label": "annual_results (annual consolidation by year/month, upsert)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_storage_buckets", "label": "Storage buckets avatars, lead-attachments, deal-documents", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L86-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_lead_roulette_lock", "label": "Lead Roleta with 5-Minute Attendance Lock", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L48,L136-L137", "rationale": "A lead assigned by the roulette is locked to the broker for 5 minutes; the lock only fires if expired leads are actively released, so the mechanism depends on a scheduled sweep.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_release_expired_leads", "label": "release_expired_leads()", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L136-L137", "rationale": "Must run roughly every 30 seconds (pg_cron or Vercel Cron). Without the cron the 5-minute attendance lock never releases, so the roulette silently stops recycling leads. Still pending.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_assign_lead", "label": "assign_lead()", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L133-L134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_perform_checkin", "label": "perform_checkin(ip)", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L134", "rationale": "Receives the caller IP so the allowed-IP lock is enforced server-side rather than trusted from the client.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_meta_ads_webhook", "label": "Edge function meta-ads-webhook", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L131-L135", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_broker_checkin", "label": "Edge function broker-checkin", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_sdr_agent_chat", "label": "Edge function sdr-agent-chat", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_sdr_whatsapp_broadcast", "label": "Edge function sdr-whatsapp-broadcast", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_director_weekly", "label": "Edge function director-weekly", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L135", "rationale": "Marked as replaceable by the public RPCs instead of being rewritten.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_daily_team_info", "label": "Edge function daily-team-info", "file_type": "code", "source_file": "supabase/README.md", "source_location": "L135", "rationale": "Marked as replaceable by the public RPCs instead of being rewritten.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_edge_functions_pending_rewrite", "label": "Pending: 8 Edge Functions Still Target the Old Tables", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L131-L135", "rationale": "All eight functions in supabase/functions/ still reference legacy table names and must be rewritten against the new schema; two of them are simply replaceable by the public RPCs.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_automatic_checkout", "label": "Pending: Automatic Checkout at End of Shift", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L138", "rationale": "Open check-ins must be closed when the shift ends, otherwise shifts stay open indefinitely.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_frontend_migration_pending", "label": "Pending: ~28 Frontend Pages Still Query Old Names", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L139-L140", "rationale": "Accepted breakage: the agreed sequencing was a clean schema first, frontend adaptation afterwards, so the pages are knowingly broken in the interim.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_typescript_types_regen", "label": "Pending: Regenerate TypeScript Types (supabase gen types)", "file_type": "concept", "source_file": "supabase/README.md", "source_location": "L141-L142", "rationale": "src/integrations/supabase/types.ts must be regenerated from the linked project so the frontend types match the new schema.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_readme_migrations_legacy", "label": "supabase/migrations_legacy/ (70 old migrations)", "file_type": "document", "source_file": "supabase/README.md", "source_location": "L144-L147", "rationale": "The 70 previous migrations were moved rather than deleted: nothing was erased, they remain for reference and are not applied.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "supabase_readme_validate_schema_harness", "target": "supabase_readme_schema_novo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/README.md", "source_location": "L28-L38", "weight": 1.0}, {"source": "supabase_readme_config_toml_project_id", "target": "supabase_readme_schema_novo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/README.md", "source_location": "L25-L26", "weight": 1.0}, {"source": "supabase_readme_schema_novo", "target": "supabase